{
  "name": "asset-cleaning-css-build",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i input.css -o ../css/style.css",
    "watch:css": "tailwindcss -c tailwind.config.js -i input.css -o ../css/style.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
